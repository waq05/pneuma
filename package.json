{
  "name": "@waq666/pneuma",
  "version": "0.9.1",
  "description": "Pneuma（numa）— 独立的终端 AI harness（自研 ReAct loop + ink TUI）",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waq05/pneuma.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "numa": "./bin/dsc.js"
  },
  "files": [
    "bin",
    "lib",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-runtime-package.mjs && node scripts/build-packages.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit && tsc -p ui-shell/tsconfig.spec.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "build:ui": "pnpm -C ui-shell build",
    "check:ui": "node scripts/check-ui.mjs",
    "check:ui:e2e": "node scripts/check-ui.mjs --e2e",
    "check:ui:list": "node scripts/check-ui.mjs --list && node scripts/check-ui.mjs --e2e --list",
    "check:dsh": "node scripts/dsh-compat-check.mjs && node scripts/dsh-bundle-check.mjs && node scripts/dsh-real-plugin-check.mjs && node scripts/dsh-session-bridge-check.mjs && node scripts/dsh-llm-event-check.mjs && node scripts/dsh-session-events-check.mjs && node scripts/dsh-compat-live-check.mjs",
    "check:core": "node scripts/check-core.mjs",
    "check:remote": "node scripts/remote-e2e.mjs",
    "check:p0": "node scripts/check-p0.mjs",
    "check:style": "node scripts/style-check.mjs",
    "check:plugin": "node scripts/plugin-model-check.mjs --strict && node scripts/plugin-standard-check.mjs && node scripts/package-tests.mjs && node scripts/plugin-inventory-check.mjs && node scripts/plugin-model-test.mjs && node scripts/plugin-list-test.mjs && node scripts/plugin-compose-check.mjs && node scripts/plugin-swap-e2e.mjs",
    "check:all": "pnpm run check:style && pnpm run check:plugin && pnpm run check:ui && pnpm run check:dsh && pnpm run check:core && pnpm run check:remote",
    "test": "vitest run --project unit --project ui",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:snapshot": "vitest run --project snapshot",
    "ui:serve": "node scripts/_ui-shell-serve.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "ink": "^6.0.0",
    "koffi": "3.1.1",
    "react": "^19.2.0",
    "semver": "^7.8.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/react-virtual": "3.14.10",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^26.1.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "koffi",
      "electron"
    ],
    "//": "react 与 react-dom 钉死同版：四个项目收成 workspace 后，pnpm 把 react 解到 19.3.0、react-dom 解到 19.3.1，后者的 peer 要 ^19.3.1，装完就在警告里躺着。两个 React 版本不一致的后果不是装不上，是运行期 hooks 报错。",
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  }
}
