{
  "name": "@waq666/pneuma",
  "version": "0.7.1",
  "description": "Pneuma（numa）— 独立的终端 AI harness（自研 ReAct loop + ink TUI）",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waq05/pneuma.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "numa": "./bin/dsc.js"
  },
  "files": [
    "bin",
    "lib",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "build:ui": "pnpm -C ui-shell build",
    "check:ui": "node scripts/check-ui.mjs",
    "check:ui:e2e": "node scripts/check-ui.mjs --e2e",
    "check:ui:list": "node scripts/check-ui.mjs --list && node scripts/check-ui.mjs --e2e --list",
    "check:dsh": "node scripts/dsh-compat-check.mjs && node scripts/dsh-bundle-check.mjs && node scripts/dsh-real-plugin-check.mjs && node scripts/dsh-session-bridge-check.mjs && node scripts/dsh-llm-event-check.mjs && node scripts/dsh-session-events-check.mjs && node scripts/dsh-compat-live-check.mjs",
    "check:core": "node scripts/check-core.mjs",
    "check:style": "node scripts/style-check.mjs",
    "check:all": "pnpm run check:style && pnpm run check:ui && pnpm run check:dsh && pnpm run check:core",
    "ui:serve": "node scripts/_ui-shell-serve.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "ink": "^6.0.0",
    "koffi": "3.1.1",
    "react": "^19.2.0",
    "semver": "^7.8.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "koffi",
      "electron"
    ],
    "//": "react 与 react-dom 钉死同版：四个项目收成 workspace 后，pnpm 把 react 解到 19.3.0、react-dom 解到 19.3.1，后者的 peer 要 ^19.3.1，装完就在警告里躺着。两个 React 版本不一致的后果不是装不上，是运行期 hooks 报错。",
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  }
}
