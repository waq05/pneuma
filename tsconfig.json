{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "strict": true,
    "outDir": "lib",
    "rootDir": "src",
    "baseUrl": ".",
    // 两条映射：@pneuma/runtime/* 是**构建生成的适配包名**（不是 src/packages/runtime），
    // 它必须继续落到 src/*；@pneuma/<id> 才是 src/packages/<id>/。
    // TypeScript 按「前缀最长的先匹配」，所以 runtime 那条永远优先，不会被下面吞掉。
    // 第二条给两个替换：裸包名（@pneuma/<id>）在 NodeNext 下不认目录入口，退回 index.ts；
    // 带子路径的写法（@pneuma/<id>/x.js）走第一项，仍是 .js→.ts 的正常替换。
    "paths": {
      "@pneuma/runtime/*": ["src/*"],
      "@pneuma/*": ["src/packages/*", "src/packages/*/index.ts"]
    },
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "types": ["node"]
  },
  "include": ["src"],
  // 排除的两种东西后果完全不同，所以放在一处写清：
  //
  // 1. 界面半（src/packages/<id>/ui/）是浏览器代码：这里没有 DOM 库、也不带 React 的类型依赖，
  //    编进来会一路报错。它们由 ui-shell/tsconfig.json 单独检查（那边有 DOM 与 jsx 环境）。
  // 2. 三个测试后缀不排掉，`tsc` 会把它们编进 `lib/`。而 package.json 的 `files` 白名单里有
  //    `lib`，于是每个 `pnpm build` 之后测试都跟着 npm 包装出去——既涨体积，又把内部断言
  //    暴露给用户。测试文件的类型检查走 tsconfig.spec.json，不靠主构建。
  "exclude": [
    "src/packages/*/ui/**",
    "src/**/*.spec.ts",
    "src/**/*.int.spec.ts",
    "src/**/*.e2e.ts"
  ]
}
