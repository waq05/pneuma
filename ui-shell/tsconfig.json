{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dsc/ui-core": ["../src/packages/ui-core/index.ts"],
      "@dsc/ui": ["./src/plugin-api.ts"],
      "@dsc/ui-boot": ["../src/packages/ui-boot/ui/index.ts"],
      "@dsc/ui-dockkit": ["../src/packages/ui-dockkit/ui/index.ts"],
      "@dsc/ui-layout": ["../src/packages/ui-layout/ui/index.ts"],
      "@dsc/ui-primitives": ["../src/packages/ui-primitives/ui/index.ts"],
      "@dsc/ui-renderer": ["../src/packages/ui-renderer/ui/index.ts"],
      "@dsc/ui-runtime": ["../src/packages/ui-runtime/ui/index.ts"],
      "@dsc/ui-slots": ["../src/packages/ui-slots/ui/index.ts"]
    }
  },
  "include": ["src", "../src/packages/ui-core", "../src/packages/*/ui"],
  // 界面半的测试文件归 Vitest 的 ui project 管（jsdom + react 插件），不进这份 `tsc --noEmit`：
  // 这份配置只做类型检查、不带测试运行时的类型，混进来会逼着壳也装一遍 vitest 的依赖。
  "exclude": ["../src/packages/*/ui/**/*.spec.ts", "../src/packages/*/ui/**/*.spec.tsx"]
}
