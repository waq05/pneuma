{
  "name": "@pneuma/ui-status",
  "version": "0.9.3",
  "description": "可收成胶囊的多分区总览浮层：Git、目标、计划、进程、终端、工作流、子智能体与智能体团队（只读任务板）",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 362,
    "resolution": "overridable",
    "title": "状态面板（界面）",
    "description": "可收成胶囊的多分区总览浮层：Git、目标、计划、进程、终端、工作流、子智能体与智能体团队（只读任务板）",
    "client": {
      "platform": "pneuma",
      "api": "^0.9.3"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
