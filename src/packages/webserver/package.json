{
  "name": "@pneuma/webserver",
  "version": "0.9.2",
  "description": "插件版界面的宿主半边：回环 HTTP + 一次性令牌 + 插件 bundle 下发（默认不占端口，桌面或 DSC_UI_SERVER=1 时才起来）",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 300,
    "resolution": "overridable",
    "title": "本机界面服务",
    "description": "插件版界面的宿主半边：回环 HTTP + 一次性令牌 + 插件 bundle 下发（默认不占端口，桌面或 DSC_UI_SERVER=1 时才起来）"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
