{
  "name": "@pneuma/lifecycle-hooks",
  "description": "在模型动手前后跑你的脚本，脚本可以拦下这次操作；事件名沿用 codex 的写法",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3670,
    "resolution": "overridable",
    "title": "外部命令钩子",
    "description": "在模型动手前后跑你的脚本，脚本可以拦下这次操作；事件名沿用 codex 的写法",
    "settingsSection": "lifecycle-hooks",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
