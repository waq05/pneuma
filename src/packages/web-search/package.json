{
  "name": "@pneuma/web-search",
  "version": "0.9.3",
  "description": "让模型上网查资料并附来源链接；默认用 DeepSeek 原生搜索，也可换 Tavily / 博查 / Serper",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3630,
    "resolution": "overridable",
    "title": "联网搜索",
    "description": "让模型上网查资料并附来源链接；默认用 DeepSeek 原生搜索，也可换 Tavily / 博查 / Serper",
    "settingsSection": "web-search",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
