{
  "name": "@pneuma/tools-default",
  "version": "0.9.2",
  "description": "注册 bash、job_output / job_list / job_kill、terminal、read、read_image、write、edit、glob、grep 共 11 件，并把超时、输出与终端选择放进设置",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 80,
    "resolution": "pinned",
    "title": "内置工具",
    "description": "注册 bash、job_output / job_list / job_kill、terminal、read、read_image、write、edit、glob、grep 共 11 件，并把超时、输出与终端选择放进设置",
    "settingsSection": "tools-default"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
