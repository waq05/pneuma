{
  "name": "@pneuma/file-review",
  "description": "写文件或改文件之前，先把要改的几行贴进对话；长改动按行截断，看得见改在哪",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3710,
    "resolution": "overridable",
    "title": "改动前预览",
    "description": "写文件或改文件之前，先把要改的几行贴进对话；长改动按行截断，看得见改在哪",
    "settingsSection": "file-review"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
