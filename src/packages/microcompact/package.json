{
  "name": "@pneuma/microcompact",
  "version": "0.9.1",
  "description": "每轮请求把较旧的工具结果正文换成占位符，只改请求体、不动会话日志",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 210,
    "resolution": "overridable",
    "title": "旧工具结果清理",
    "description": "每轮请求把较旧的工具结果正文换成占位符，只改请求体、不动会话日志",
    "settingsSection": "microcompact"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
