{
  "name": "@pneuma/desktop-dock",
  "description": "把当前会话工作目录里的文件系统、Git 与终端三类操作开给桌面面板：写类先过审批，终端只从桌面原生桥进来",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 310,
    "resolution": "overridable",
    "title": "桌面能力桥",
    "description": "把当前会话工作目录里的文件系统、Git 与终端三类操作开给桌面面板：写类先过审批，终端只从桌面原生桥进来"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
