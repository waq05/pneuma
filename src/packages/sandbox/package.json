{
  "name": "@pneuma/sandbox",
  "description": "限定模型能写哪里：越界写、关网时联网当场拒；要破例得带理由弹审批卡",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3700,
    "resolution": "overridable",
    "title": "文件与命令围栏",
    "description": "限定模型能写哪里：越界写、关网时联网当场拒；要破例得带理由弹审批卡",
    "settingsSection": "sandbox",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
