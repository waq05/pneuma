{
  "name": "@pneuma/host-stdio",
  "description": "桌面壳与宿主进程的协议桥：stdio / parentPort 双传输自动选一种，并提供 interactive（有没有人能答审批卡）与 HOST_BROWSER_SERVICE（侧栏浏览器链路）",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 9010,
    "resolution": "overridable",
    "title": "宿主协议桥",
    "description": "桌面壳与宿主进程的协议桥：stdio / parentPort 双传输自动选一种，并提供 interactive（有没有人能答审批卡）与 HOST_BROWSER_SERVICE（侧栏浏览器链路）"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
