{
  "name": "@pneuma/ui-team",
  "version": "0.9.3",
  "description": "子智能体的名册轮询、正文区只读运行记录（发话 / 停止 / 移除）与右栏页签；成员列表只在状态面板列一次，本包不再画标题旁按钮",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 365,
    "resolution": "overridable",
    "title": "子智能体（界面）",
    "description": "子智能体的名册轮询、正文区只读运行记录（发话 / 停止 / 移除）与右栏页签；成员列表只在状态面板列一次，本包不再画标题旁按钮",
    "client": {
      "platform": "pneuma",
      "api": "^0.9.3"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
