{
  "name": "@pneuma/ui-team",
  "description": "标题旁「智能体团队」入口与团队面板：名册每 3 秒刷新，点一行在正文区只读打开队友的完整会话；子智能体列表在状态面板，共享任务板不在这里",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 365,
    "resolution": "overridable",
    "title": "智能体团队（界面）",
    "description": "标题旁「智能体团队」入口与团队面板：名册每 3 秒刷新，点一行在正文区只读打开队友的完整会话；子智能体列表在状态面板，共享任务板不在这里",
    "client": {
      "platform": "pneuma",
      "api": "^0.9.0"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
