{
  "name": "@pneuma/ui-composer",
  "description": "输入框、模型与思考档位旋钮、附件、排队消息条",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 353,
    "resolution": "overridable",
    "title": "输入区（界面）",
    "description": "输入框、模型与思考档位旋钮、附件、排队消息条",
    "client": {
      "platform": "pneuma",
      "api": "^0.8.1",
      "phase": "early"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
