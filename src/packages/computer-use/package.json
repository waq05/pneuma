{
  "name": "@pneuma/computer-use",
  "version": "0.9.1",
  "description": "看屏幕、点按钮、输入文字来操作 Windows 桌面；看可免审批，动手每次要确认",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3620,
    "resolution": "overridable",
    "title": "操作电脑桌面",
    "description": "看屏幕、点按钮、输入文字来操作 Windows 桌面；看可免审批，动手每次要确认",
    "settingsSection": "computer-use",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
