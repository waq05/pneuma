{
  "name": "@pneuma/ui-ask",
  "version": "0.9.2",
  "description": "右侧栏的只读旁问：基于当前上下文答一次，不执行工具、不写主会话、不进会话列表；ask_user 的选项卡不在这里，在「等待用户决定的卡」",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 351,
    "resolution": "overridable",
    "title": "旁问（界面）",
    "description": "右侧栏的只读旁问：基于当前上下文答一次，不执行工具、不写主会话、不进会话列表；ask_user 的选项卡不在这里，在「等待用户决定的卡」",
    "client": {
      "platform": "pneuma",
      "api": "^0.9.1"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
