{
  "name": "@pneuma/permission-presets",
  "version": "0.9.3",
  "description": "把沙箱档位、权限模式与审阅者三根旋钮捆成一颗按钮：切换只写当前会话，预设只调沙箱与审批已有的接口，放宽不了安全",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 180,
    "resolution": "overridable",
    "title": "权限预设",
    "description": "把沙箱档位、权限模式与审阅者三根旋钮捆成一颗按钮：切换只写当前会话，预设只调沙箱与审批已有的接口，放宽不了安全"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
