{
  "name": "@pneuma/ptc",
  "description": "run_code 工具：模型写一段脚本批量调工具，只把结论交回上下文（只属于 PTC 模式）",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 150,
    "resolution": "overridable",
    "title": "PTC 代码调用",
    "description": "run_code 工具：模型写一段脚本批量调工具，只把结论交回上下文（只属于 PTC 模式）"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
