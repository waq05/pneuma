{
  "name": "@pneuma/spill",
  "description": "工具输出太长就存成文件，模型先看头尾几行；需要细节时按路径续读，上下文不会被日志撑爆",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3650,
    "resolution": "overridable",
    "title": "长输出转存",
    "description": "工具输出太长就存成文件，模型先看头尾几行；需要细节时按路径续读，上下文不会被日志撑爆",
    "settingsSection": "spill"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
