{
  "name": "@pneuma/session-search",
  "description": "按关键词翻以前聊过的会话，中文一两个字也能搜到；提供 session_search 工具与 /search 命令",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3660,
    "resolution": "overridable",
    "title": "历史会话搜索",
    "description": "按关键词翻以前聊过的会话，中文一两个字也能搜到；提供 session_search 工具与 /search 命令",
    "settingsSection": "session-search",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
