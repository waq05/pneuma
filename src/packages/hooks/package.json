{
  "name": "@pneuma/hooks",
  "description": "工具动手之前按你自己登记的规则与脚本拦一道；也能按 codex 事件名跑外部命令钩子",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 190,
    "resolution": "pinned",
    "title": "安全钩子",
    "description": "工具动手之前按你自己登记的规则与脚本拦一道；也能按 codex 事件名跑外部命令钩子",
    "settingsSection": "hooks"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
