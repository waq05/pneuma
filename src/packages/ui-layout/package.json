{
  "name": "@pneuma/ui-layout",
  "description": "界面壳的骨架与运行时：App 骨架、审查栏、正文区的两张脸、宿主通道与外观落地",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 349,
    "resolution": "overridable",
    "title": "界面骨架",
    "description": "界面壳的骨架与运行时：App 骨架、审查栏、正文区的两张脸、宿主通道与外观落地",
    "client": {
      "platform": "pneuma",
      "api": "^0.8.1",
      "phase": "early"
    }
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
