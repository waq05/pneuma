{
  "name": "@pneuma/git",
  "description": "只给界面读的分支名与改动条数：不注册任何 git 工具，模型要跑 git 只能走 bash",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 320,
    "resolution": "overridable",
    "title": "Git 只读快照面",
    "description": "只给界面读的分支名与改动条数：不注册任何 git 工具，模型要跑 git 只能走 bash"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
