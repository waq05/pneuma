{
  "name": "@pneuma/plugin-manager",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
