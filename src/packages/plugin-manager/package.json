{
  "name": "@pneuma/plugin-manager",
  "version": "0.9.2",
  "description": "让模型列出、开关、安装本地或远程插件；写操作先过审批，远程插件装之前把来源写进审批卡",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 330,
    "resolution": "overridable",
    "title": "插件管理",
    "description": "让模型列出、开关、安装本地或远程插件；写操作先过审批，远程插件装之前把来源写进审批卡"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
