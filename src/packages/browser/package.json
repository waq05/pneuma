{
  "name": "@pneuma/browser",
  "description": "模型自己开一台隔离 Chrome，按页面元素点击输入；动作每次审批，可设域名黑白名单",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3740,
    "resolution": "overridable",
    "title": "受控浏览器",
    "description": "模型自己开一台隔离 Chrome，按页面元素点击输入；动作每次审批，可设域名黑白名单",
    "settingsSection": "browser",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
