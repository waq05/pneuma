{
  "name": "@pneuma/ui-browser",
  "version": "0.9.3",
  "description": "右侧栏给人用的浏览器页签：一张页签一台原生网页视图，可多开、不需要审批；模型那台受控 Chrome 在「受控浏览器」",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./ui/ui.tsx",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 352,
    "resolution": "overridable",
    "title": "侧栏浏览器（界面）",
    "description": "右侧栏给人用的浏览器页签：一张页签一台原生网页视图，可多开、不需要审批；模型那台受控 Chrome 在「受控浏览器」",
    "client": {
      "platform": "pneuma",
      "api": "^0.9.3"
    },
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
