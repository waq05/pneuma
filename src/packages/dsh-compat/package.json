{
  "name": "@pneuma/dsh-compat",
  "version": "0.9.3",
  "description": "让按 dsh 写法做的外部插件也能装进来跑；补 logger、模块解析与工具注册的差异",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3780,
    "resolution": "overridable",
    "title": "dsh 插件兼容",
    "description": "让按 dsh 写法做的外部插件也能装进来跑；补 logger、模块解析与工具注册的差异",
    "toggleable": true,
    "experimental": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
