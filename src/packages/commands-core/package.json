{
  "name": "@pneuma/commands-core",
  "version": "0.9.2",
  "description": "斜杠命令表、补全候选与唯一前缀展开的唯一一份实现；commands / runtime / tui 与界面输入框共用",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./commands-completion.js": "./commands-completion.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "locale/**"
  ],
  "pneuma": {
    "library": true,
    "title": "命令补全库",
    "description": "斜杠命令表、补全候选与唯一前缀展开的唯一一份实现；commands / runtime / tui 与界面输入框共用"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
