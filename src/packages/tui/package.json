{
  "name": "@pneuma/tui",
  "version": "0.9.3",
  "description": "把同一套运行时挂到 ink 终端：整屏跑在备用屏里，声明 platform 为 tui 的界面插件渲染在通知盒下方",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 9000,
    "resolution": "overridable",
    "title": "终端界面",
    "description": "把同一套运行时挂到 ink 终端：整屏跑在备用屏里，声明 platform 为 tui 的界面插件渲染在通知盒下方"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
