{
  "name": "@pneuma/dock-browser",
  "description": "让模型操作桌面端侧栏那台浏览器；看页面可免审批，动手每次要确认",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "locale/**"
  ],
  "pneuma": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "order": 3750,
    "resolution": "overridable",
    "title": "侧栏浏览器",
    "description": "让模型操作桌面端侧栏那台浏览器；看页面可免审批，动手每次要确认",
    "settingsSection": "dock-browser",
    "toggleable": true
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
