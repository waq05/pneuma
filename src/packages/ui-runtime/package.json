{
  "name": "@pneuma/ui-runtime",
  "version": "0.9.2",
  "description": "界面壳的共享运行时：宿主通道、React 上下文与读数 hook、页与视图信号、外观落地、今日用量；作为平台种子下发给界面插件",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "locale/**"
  ],
  "pneuma": {
    "library": true,
    "title": "界面运行时",
    "description": "界面壳的共享运行时：宿主通道、React 上下文与读数 hook、页与视图信号、外观落地、今日用量；作为平台种子下发给界面插件"
  },
  "engines": {
    "pneuma": ">=1.0.0 <2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
